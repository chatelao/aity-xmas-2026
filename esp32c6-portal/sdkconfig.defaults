# Target SoC
CONFIG_IDF_TARGET="esp32c6"

# Flash configuration (Seeed Studio XIAO ESP32-C6 has 4 MB QIO flash)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Wi-Fi SoftAP & LWIP
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_LWIP_SO_REUSE=y

# HTTP Server (increase max URI handlers and header size for captive portal & REST API)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_ERR_RESP_NO_DELAY=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Console over USB Serial/JTAG (XIAO ESP32-C6 native USB)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
